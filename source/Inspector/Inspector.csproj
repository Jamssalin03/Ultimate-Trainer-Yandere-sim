<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>YandereUltimate.Inspector</AssemblyName>
    <RootNamespace>YandereUltimate.Inspector</RootNamespace>
    <Version>1.1.0</Version>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Comun\*.cs" Link="Comun\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\compatibilidad.json" LogicalName="compatibilidad.json" />
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
  </ItemGroup>
</Project>
