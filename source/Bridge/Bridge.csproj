<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>YandereUltimate.Bridge</AssemblyName>
    <RootNamespace>YandereUltimate</RootNamespace>
    <Version>1.1.0</Version>
    <GameManaged>$(GameDir)\YandereSimulator_Data\Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Comun\*.cs" Link="Comun\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\compatibilidad.json" LogicalName="compatibilidad.json" />
    <InternalsVisibleTo Include="YandereUltimate.Pruebas" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BepInEx"><HintPath>$(LoaderDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AstarPathfindingProject"><HintPath>$(GameManaged)\AstarPathfindingProject.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(GameManaged)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidarJuego" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')">
    <Error Text="No se encontró el juego (falta YandereSimulator_Data\Managed\Assembly-CSharp.dll en '$(GameDir)'). Compilá con Compilar.ps1 (detecta la instalación) o indicá -p:GameDir=&quot;C:\ruta\al\juego&quot;." />
  </Target>
</Project>
